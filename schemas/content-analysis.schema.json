{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {"type": "string"},
    "core_question": {"type": "string"},
    "key_concept": {"type": "string"},
    "hook_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {"type": "string"},
          "claim": {"type": "string"},
          "source_excerpt": {"type": "string", "minLength": 1},
          "visualizable": {"type": "boolean"}
        },
        "required": ["evidence_id", "claim", "source_excerpt", "visualizable"],
        "additionalProperties": false
      }
    },
    "causal_chain": {"type": "array", "items": {"type": "string"}},
    "misconception_risks": {"type": "array", "items": {"type": "string"}},
    "needs_verification": {"type": "array", "items": {"type": "string"}}
  },
  "required": [
    "title",
    "core_question",
    "key_concept",
    "hook_candidates",
    "evidence",
    "causal_chain",
    "misconception_risks",
    "needs_verification"
  ],
  "additionalProperties": false
}

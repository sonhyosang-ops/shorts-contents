{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {"type": "string"},
    "hook": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 60, "maximum": 75},
    "lines": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required": ["start", "end", "text", "evidence_ids"],
        "additionalProperties": false
      }
    },
    "full_text": {"type": "string"},
    "ending": {"type": "string"}
  },
  "required": ["title", "hook", "duration_seconds", "lines", "full_text", "ending"],
  "additionalProperties": false
}
